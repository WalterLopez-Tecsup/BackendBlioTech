      "name": "auth-service",
      "item": [
        {
          "name": "Login (obtener token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Retorna token', () => pm.expect(body.token).to.be.a('string'));",
                  "pm.test('Retorna datos del socio', () => {",
                  "    pm.expect(body.nombre).to.be.a('string');",
                  "    pm.expect(body.usuario).to.be.a('string');",
                  "    pm.expect(body.email).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('token', body.token);",
                  "console.log('Token guardado:', body.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"wlopez\",\n  \"clave\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        },
